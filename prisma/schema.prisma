generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String            @id @default(cuid())
  username  String            @unique
  password  String
  fullName  String?
  email     String?           @unique
  bio       String?
  avatarUrl String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  
  // ✅ TAMBAHKAN INI: Relasi ke LectureSchedule
  schedules LectureSchedule[]
}

model LectureSchedule {
  id             String   @id @default(cuid())
  userId         String
  // ✅ Tambahkan 'map' agar field 'user' tidak bentrok dengan Prisma client
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "lecture_user")
  
  subjectName    String
  lecturer       String?
  room           String?
  
  // Waktu kuliah
  dayOfWeek      Int      // 0=Sunday, 1=Monday, ..., 6=Saturday
  startTime      String   // Format "HH:mm"
  durationMin    Int      @default(90)
  
  // Alarm settings
  alarmOffsetMin Int      @default(30)
  isEnabled      Boolean  @default(true)
  soundUri       String?
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("lecture_schedules")
}